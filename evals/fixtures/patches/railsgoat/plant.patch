diff --git a/spec/guards/message_scoping_spec.rb b/spec/guards/message_scoping_spec.rb
new file mode 100644
index 0000000..fd3d1a6
--- /dev/null
+++ b/spec/guards/message_scoping_spec.rb
@@ -0,0 +1,35 @@
+# frozen_string_literal: true
+require "spec_helper"
+
+# Guard for the invariant "a message is visible only to its receiver"
+# (docs/audits/2026-10-03-messages.md, finding MSG-1). Both halves matter: a guard that checks
+# only the blocked path lets an over-restrictive fix through unnoticed.
+feature "guard: messages are scoped to the signed-in receiver" do
+  let(:normal_user) { UserFixture.normal_user }
+  let(:another_user) { User.find_by(id: 2) }
+
+  before do
+    UserFixture.reset_all_users
+  end
+
+  scenario "blocks the attack path: a message addressed to someone else is not shown" do
+    login(normal_user)
+    foreign = Message.create!(creator_id: another_user.id, receiver_id: another_user.id,
+                              message: "quarterly numbers, do not forward")
+
+    visit "/users/#{normal_user.id}/messages/#{foreign.id}"
+
+    expect(page).not_to have_content("quarterly numbers")
+    expect(page).to have_content("Message not found")
+  end
+
+  scenario "lets the legitimate path through: the receiver still reads their own message" do
+    login(normal_user)
+    own = Message.create!(creator_id: another_user.id, receiver_id: normal_user.id,
+                          message: "welcome aboard")
+
+    visit "/users/#{normal_user.id}/messages/#{own.id}"
+
+    expect(page).to have_content("welcome aboard")
+  end
+end
