+/// <reference types="Cypress" />
+
+// Guard for the invariant "the benefits page is admin-only"
+// (docs/audits/2026-10-03-access-control.md, finding AC-1). Both halves matter: a guard that
+// checks only the blocked path lets an over-restrictive fix through unnoticed.
+describe("guard: /benefits is admin-only", () => {
+  "use strict";
+
+  before(() => {
+    cy.dbReset();
+  });
+
+  afterEach(() => {
+    cy.visitPage("/logout");
+  });
+
+  it("blocks the attack path: a signed-in non-admin user is sent to login", () => {
+    cy.userSignIn();
+    cy.visitPage("/benefits");
+    cy.url().should("include", "login");
+  });
+
+  it("lets the legitimate path through: an admin sees the benefits table", () => {
+    cy.adminSignIn();
+    cy.visitPage("/benefits");
+    cy.url().should("include", "benefits");
+    cy.get("table tr");
+  });
+});
